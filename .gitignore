# ---- Secrets & per-developer backend config (never commit) ----
# Environment files
.env
.env.*
!.env.example

# Supabase: URL + key used by `flutter run --dart-define-from-file`
stocksapp/supabase.json
stocksapp/supabase/.temp/
stocksapp/supabase/.branches/

# Firebase: generated by `flutterfire configure` / `firebase use`
stocksapp/lib/firebase_options.dart
stocksapp/android/app/google-services.json
stocksapp/ios/Runner/GoogleService-Info.plist
stocksapp/macos/Runner/GoogleService-Info.plist
stocksapp/.firebaserc
stocksapp/firebase-debug*.log
stocksapp/dataconnect-debug.log
stocksapp/pglite-debug.log
stocksapp/dataconnect/.dataconnect/pgliteData/

# Service-account / private keys
*service-account*.json
*-adminsdk-*.json
*.pem
*.p12
*.key
*.keystore
*.jks
key.properties

# ---- OS / editor noise ----
.DS_Store
.idea/
*.iml
